# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.
APP_NAME=Jal (working name)
DATABASE_URL=postgresql+psycopg://jal:jal@localhost:5433/jal
# AWS: personal account via the "spice" CLI profile. NEVER the office "default" profile.
AWS_PROFILE=spice
AWS_REGION=ap-south-1
CLASSIFY_MODEL=in.anthropic.claude-haiku-4-5-20251001-v1:0
BRIEF_MODEL=in.anthropic.claude-haiku-4-5-20251001-v1:0
# LLM fallback order. After adding a payment card to the AWS account: bedrock,groq,nova
LLM_PROVIDERS=groq,nova,bedrock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
APIFY_TOKEN=
RAW_BUCKET=
ADMIN_TOKEN=change-me
