{
  "openapi": "3.1.0",
  "info": {
    "title": "Jal (working name)",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/pipeline/run": {
      "post": {
        "tags": [
          "pipeline"
        ],
        "summary": "Trigger Run",
        "description": "Start a full pipeline run in the background; poll GET /runs/{id} for its stats.",
        "operationId": "trigger_run_admin_pipeline_run_post",
        "parameters": [
          {
            "name": "x-admin-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Admin-Token"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStarted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/pipeline/runs": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "List Runs",
        "operationId": "list_runs_admin_pipeline_runs_get",
        "parameters": [
          {
            "name": "x-admin-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Admin-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PipelineRunOut"
                  },
                  "title": "Response List Runs Admin Pipeline Runs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/pipeline/runs/{run_id}": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Get Run",
        "operationId": "get_run_admin_pipeline_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          },
          {
            "name": "x-admin-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Admin-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineRunOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/zones": {
      "get": {
        "tags": [
          "map"
        ],
        "summary": "Map Zones",
        "description": "Live and watch zones for one hazard as a GeoJSON FeatureCollection.",
        "operationId": "map_zones_api_v1_map_zones_get",
        "parameters": [
          {
            "name": "hazard",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "drought",
                "flood",
                "heat",
                "water"
              ],
              "type": "string",
              "title": "Hazard"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Map Zones Api V1 Map Zones Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/districts": {
      "get": {
        "tags": [
          "map"
        ],
        "summary": "Map Districts",
        "description": "Every district with its latest indicator band for the hazard (cached for 10 minutes).",
        "operationId": "map_districts_api_v1_map_districts_get",
        "parameters": [
          {
            "name": "hazard",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "drought",
                "flood",
                "heat",
                "water"
              ],
              "type": "string",
              "title": "Hazard"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Map Districts Api V1 Map Districts Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/footprint": {
      "get": {
        "tags": [
          "map"
        ],
        "summary": "Map Footprint",
        "description": "Talukas flagged by measured drought data (or an official declaration), as GeoJSON with their level.",
        "operationId": "map_footprint_api_v1_map_footprint_get",
        "parameters": [
          {
            "name": "hazard",
            "in": "query",
            "required": true,
            "schema": {
              "const": "drought",
              "type": "string",
              "title": "Hazard"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Map Footprint Api V1 Map Footprint Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/signals": {
      "get": {
        "tags": [
          "map"
        ],
        "summary": "Map Signals",
        "description": "Recent located posts (newest first, at most 1,000) as GeoJSON points.",
        "operationId": "map_signals_api_v1_map_signals_get",
        "parameters": [
          {
            "name": "hazard",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "drought",
                "flood",
                "heat",
                "water"
              ],
              "type": "string",
              "title": "Hazard"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 720,
              "minimum": 1,
              "default": 48,
              "title": "Hours"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Map Signals Api V1 Map Signals Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/feed": {
      "get": {
        "tags": [
          "read"
        ],
        "summary": "Feed",
        "description": "Relevant classified posts, newest first. Pass `next_cursor` back as `cursor` for the next page.",
        "operationId": "feed_api_v1_feed_get",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/zones": {
      "get": {
        "tags": [
          "read"
        ],
        "summary": "Zones",
        "operationId": "zones_api_v1_zones_get",
        "parameters": [
          {
            "name": "hazard",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "drought",
                    "flood",
                    "heat",
                    "water"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hazard"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "watch",
                    "active",
                    "approved",
                    "resolving"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ZoneSummary"
                  },
                  "title": "Response Zones Api V1 Zones Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/zones/{zone_id}": {
      "get": {
        "tags": [
          "read"
        ],
        "summary": "Zone Detail",
        "description": "One zone with the evidence and the arithmetic that put it on the map.",
        "operationId": "zone_detail_api_v1_zones__zone_id__get",
        "parameters": [
          {
            "name": "zone_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Zone Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/overview": {
      "get": {
        "tags": [
          "read"
        ],
        "summary": "Stats Overview",
        "operationId": "stats_overview_api_v1_stats_overview_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOverview"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ops/summary": {
      "get": {
        "tags": [
          "read"
        ],
        "summary": "Ops Summary",
        "operationId": "ops_summary_api_v1_ops_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/live": {
      "get": {
        "tags": [
          "live"
        ],
        "summary": "Live",
        "description": "Server-Sent Events: `signal` when a post is classified, `zone` when a zone escalates.",
        "operationId": "live_api_v1_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Contribution": {
        "properties": {
          "signal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Signal Id"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          },
          "share": {
            "type": "number",
            "title": "Share"
          }
        },
        "type": "object",
        "required": [
          "signal_id",
          "weight",
          "share"
        ],
        "title": "Contribution"
      },
      "DeclarationInfo": {
        "properties": {
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "declared_on": {
            "type": "string",
            "format": "date",
            "title": "Declared On"
          },
          "order_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Ref"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "severity",
          "declared_on",
          "order_ref",
          "source_url"
        ],
        "title": "DeclarationInfo"
      },
      "DroughtPanel": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "rules_version": {
            "type": "string",
            "title": "Rules Version"
          },
          "level": {
            "type": "string",
            "title": "Level"
          },
          "trigger1": {
            "type": "boolean",
            "title": "Trigger1"
          },
          "t1_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "T1 Class"
          },
          "soil_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Soil Class"
          },
          "spi_6p": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spi 6P"
          },
          "spi_18p": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spi 18P"
          },
          "spi_period": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spi Period"
          },
          "soil_anomaly": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Soil Anomaly"
          },
          "soil_period": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Soil Period"
          },
          "people_in_dry_areas": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "People In Dry Areas"
          },
          "people_in_dry_areas_urban": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "People In Dry Areas Urban"
          },
          "imd_district_departure_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imd District Departure Pct"
          },
          "imd_deficient": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imd Deficient"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "declared": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeclarationInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "label",
          "rules_version",
          "level",
          "trigger1",
          "t1_class",
          "soil_class",
          "spi_6p",
          "spi_18p",
          "spi_period",
          "soil_anomaly",
          "soil_period",
          "people_in_dry_areas",
          "people_in_dry_areas_urban",
          "imd_district_departure_pct",
          "imd_deficient",
          "reasons",
          "declared"
        ],
        "title": "DroughtPanel",
        "description": "The measured data behind a drought zone (GoI Drought Manual rules)."
      },
      "EvidenceItem": {
        "properties": {
          "signal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Signal Id"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          },
          "credibility": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credibility"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          },
          "severity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "place": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place"
          }
        },
        "type": "object",
        "required": [
          "signal_id",
          "quote",
          "summary",
          "title",
          "source",
          "domain",
          "credibility",
          "weight",
          "severity",
          "url",
          "published_at",
          "place"
        ],
        "title": "EvidenceItem"
      },
      "FeedItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "english_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "English Summary"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          },
          "place": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          },
          "credibility": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credibility"
          },
          "severity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
